-- ============================================================
-- MIGRATION 005: Invoice State Machine & Constraints (Idempotent)
-- Menambahkan constraint dan kolom untuk state machine
-- ============================================================

DO $$
BEGIN
    -- 1. Pastikan kolom payment_status ada
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'invoices' AND column_name = 'payment_status'
    ) THEN
        ALTER TABLE invoices ADD COLUMN payment_status VARCHAR(20) DEFAULT 'UNPAID';
    END IF;

    -- 2. Pastikan kolom paid_at ada
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'invoices' AND column_name = 'paid_at'
    ) THEN
        ALTER TABLE invoices ADD COLUMN paid_at TIMESTAMP;
    END IF;

    -- 3. Pastikan kolom paid_amount ada
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'invoices' AND column_name = 'paid_amount'
    ) THEN
        ALTER TABLE invoices ADD COLUMN paid_amount DECIMAL(12, 2);
    END IF;

    -- 4. Pastikan kolom paid_by_admin_id ada
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'invoices' AND column_name = 'paid_by_admin_id'
    ) THEN
        ALTER TABLE invoices ADD COLUMN paid_by_admin_id UUID REFERENCES users(id) ON DELETE SET NULL;
    END IF;

    -- 5. Pastikan kolom payment_notes ada
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns 
        WHERE table_name = 'invoices' AND column_name = 'payment_notes'
    ) THEN
        ALTER TABLE invoices ADD COLUMN payment_notes TEXT;
    END IF;

    -- 6. Tambahkan constraint valid_paid_state jika belum ada
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint WHERE conname = 'valid_paid_state'
    ) THEN
        ALTER TABLE invoices ADD CONSTRAINT valid_paid_state CHECK (
            (payment_status = 'UNPAID' AND paid_at IS NULL AND paid_amount IS NULL)
            OR
            (payment_status = 'PAID' AND paid_at IS NOT NULL AND paid_amount IS NOT NULL)
        );
    END IF;

    -- 7. Tambahkan trigger untuk mencegah status reversal
    CREATE OR REPLACE FUNCTION prevent_invoice_status_reversal()
    RETURNS TRIGGER AS $$
    BEGIN
        IF OLD.payment_status = 'PAID' AND NEW.payment_status = 'UNPAID' THEN
            RAISE EXCEPTION 'Cannot reverse invoice status from PAID to UNPAID';
        END IF;
        RETURN NEW;
    END;
    $$ LANGUAGE plpgsql;

    DROP TRIGGER IF EXISTS invoice_status_reversal_trigger ON invoices;
    CREATE TRIGGER invoice_status_reversal_trigger
    BEFORE UPDATE ON invoices
    FOR EACH ROW
    EXECUTE FUNCTION prevent_invoice_status_reversal();

    -- 8. Tambahkan index untuk query cepat
    CREATE INDEX IF NOT EXISTS idx_invoices_payment_status ON invoices(payment_status);
    CREATE INDEX IF NOT EXISTS idx_invoices_paid_at ON invoices(paid_at);
END $$;
