-- ====================================================================
-- MIGRATION: 002_booking_system
-- Deskripsi: Tambah kolom untuk booking system & index availability
-- ====================================================================

-- Tambah kolom ke tabel bookings
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS temp_profile_flag BOOLEAN DEFAULT FALSE;
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS queue_number INTEGER;
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS cancelled_at TIMESTAMP;
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS patient_notes TEXT;

-- Index untuk pengecekan ketersediaan slot (cepat)
-- Hanya booking yang belum dibatalkan yang dihitung
CREATE INDEX IF NOT EXISTS idx_bookings_availability 
ON bookings(branch_id, doctor_id, booking_date, session_start) 
WHERE status NOT IN ('CANCELLED');

-- Index untuk filter pasien
CREATE INDEX IF NOT EXISTS idx_bookings_patient_status 
ON bookings(patient_id, status);

-- Index untuk admin/branch
CREATE INDEX IF NOT EXISTS idx_bookings_branch_date 
ON bookings(branch_id, booking_date);

-- Validasi: check_in_code harus unik (jika belum ada constraint)
DO $$ 
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint WHERE conname = 'bookings_check_in_code_key'
    ) THEN
        ALTER TABLE bookings ADD CONSTRAINT bookings_check_in_code_key UNIQUE (check_in_code);
    END IF;
END $$;
