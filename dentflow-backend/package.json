{
  "name": "dentflow-backend",
  "version": "1.0.0",
  "description": "DentFlow Backend API - Sistem Manajemen Klinik Gigi",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --files src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:config": "ts-node src/config/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "migrate": "ts-node src/utils/migrate.ts",
    "seed": "ts-node scripts/seed-booking-data.ts",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand --forceExit tests/integration/queue.redis.test.ts",
    "test:postman": "newman run postman/dentflow-api.postman_collection.json -e postman/dentflow-dev.postman_environment.json --reporters cli,json --reporter-json-export postman/results.json --bail --delay-request 1000",
    "vercel-build": "tsc",
    "vercel-dev": "vercel dev"
  },
  "author": "M. Arif Aulia",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vercel/node": "^12.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.44.0",
    "express-list-routes": "^1.3.2",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.1.6"
  }
}
