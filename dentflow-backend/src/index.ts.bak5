import 'dotenv/config';
import express, { Express } from 'express';
import cors from 'cors';
import helmet from 'helmet';
import { config } from './config';
import { logger } from './utils/logger';
import { errorHandler } from './middleware/errorHandler';
import { rateLimiter } from './middleware/rateLimiter';
import { requestLoggerMiddleware } from './middleware/requestLogger';
import { pool } from './config/database';

// Import routes
import authRoutes from './routes/auth.routes';
import healthRoutes from './routes/health.routes';
import webhookRoutes from './routes/webhook.routes';
import bookingRoutes from './routes/booking.routes';
import queueRoutes from './routes/queue.routes';
import notificationRoutes from './routes/notification.routes';
import doctorScheduleRoutes from './routes/doctorSchedule.routes';
import auditRoutes from './routes/audit.routes';
import invoicePaymentRoutes from './routes/invoicePayment.routes';
import encounterRoutes from ./routes/encounter.routes;

// Import job scheduler
import { jobScheduler } from './jobs/jobScheduler';

const app: Express = express();
const PORT = config.server.port;

// Middleware global
app.use(helmet());
app.use(cors());
app.use(express.json({ limit: '1mb' }));
app.use(rateLimiter);
app.use(requestLoggerMiddleware);

// Routes
app.use('/health', healthRoutes);
app.use('/auth', authRoutes);
app.use('/webhooks', webhookRoutes);
app.use('/api/patient/bookings', bookingRoutes);
app.use('/api/queue', queueRoutes);
app.use('/api/admin', notificationRoutes);
app.use('/api/doctors', doctorScheduleRoutes);
app.use('/api/admin/audit-logs', auditRoutes);
app.use('/api/invoices', invoicePaymentRoutes);
app.use('/api/encounters', encounterRoutes);

// Global error handler
app.use(errorHandler);

// Start server
app.listen(PORT, () => {
  logger.info(`✅ DentFlow API starting on port ${PORT}`);
  logger.info(`   Environment: ${config.server.nodeEnv}`);
  logger.info(`   Database: ${config.database.url}`);
  logger.info(`   Redis: ${config.redis.url}`);
  
  // Initialize job scheduler after server is running
  jobScheduler.initialize();
});

// Graceful shutdown
process.on('SIGTERM', async () => {
  logger.info('SIGTERM received, closing database pool...');
  await pool.end();
  process.exit(0);
});

process.on('SIGINT', async () => {
  logger.info('SIGINT received, closing database pool...');
  await pool.end();
  process.exit(0);
});

export { app };
