import { Request, Response } from 'express';
import { PatientHistoryService } from '../services/patientHistory.service';
import { logger } from '../utils/logger';
import { getErrorMessage, getErrorStack } from '../utils/error.util';

const patientHistoryService = new PatientHistoryService();

/**
 * GET /api/patients/:id/history?branchId=xxx
 * Get patient history (patient, doctor, admin)
 */
export const getPatientHistory = async (req: Request, res: Response) => {
  try {
    const patientId = req.params.id;
    const branchId = req.query.branchId as string;
    const userId = req.user?.userId;
    const userRole = req.user?.role;

    if (!patientId || !branchId) {
      return res.status(400).json({ success: false, message: 'patientId and branchId required' });
    }

    // Authorization: only patient themselves, doctor, or admin can view history
    if (userRole === 'PATIENT') {
      // Check if the patient matches the token user
      const patientCheck = await patientHistoryService['pool'].query(
        'SELECT user_id FROM patients WHERE id = $1',
        [patientId]
      );
      if (patientCheck.rows.length === 0 || patientCheck.rows[0].user_id !== userId) {
        return res.status(403).json({ success: false, message: 'Forbidden' });
      }
    } else if (userRole === 'DOCTOR' || userRole === 'ADMIN_BRANCH') {
      // Doctor/admin must have same branch_id
      const branchCheck = await patientHistoryService['pool'].query(
        'SELECT branch_id FROM patients WHERE id = $1',
        [patientId]
      );
      if (branchCheck.rows.length === 0 || branchCheck.rows[0].branch_id !== branchId) {
        return res.status(403).json({ success: false, message: 'Forbidden' });
      }
    } else {
      return res.status(403).json({ success: false, message: 'Forbidden' });
    }

    const history = await patientHistoryService.getPatientHistory(patientId, branchId);
    res.status(200).json({ success: true, data: history });
  } catch (error: unknown) {
    const message = getErrorMessage(error);
    const stack = getErrorStack(error);
    logger.error({ error: message, stack }, 'Error fetching patient history');
    res.status(500).json({ success: false, message: 'Internal server error' });
  }
};

/**
 * GET /api/patients/:id/medical-records?branchId=xxx
 * Get medical records (doctor only)
 */
export const getMedicalRecords = async (req: Request, res: Response) => {
  try {
    const patientId = req.params.id;
    const branchId = req.query.branchId as string;
    const userId = req.user?.userId;
    const userRole = req.user?.role;

    if (!patientId || !branchId) {
      return res.status(400).json({ success: false, message: 'patientId and branchId required' });
    }

    // Only doctor can access medical records
    if (userRole !== 'DOCTOR') {
      return res.status(403).json({ success: false, message: 'Forbidden' });
    }

    const records = await patientHistoryService.getMedicalRecords(patientId, branchId);
    res.status(200).json({ success: true, data: records });
  } catch (error: unknown) {
    const message = getErrorMessage(error);
    const stack = getErrorStack(error);
    logger.error({ error: message, stack }, 'Error fetching medical records');
    res.status(500).json({ success: false, message: 'Internal server error' });
  }
};
