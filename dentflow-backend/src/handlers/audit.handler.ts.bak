import { Request, Response } from 'express';
import { auditService } from '../services/audit.service';
import { logger } from '../utils/logger';
import { getErrorMessage, getErrorStack } from '../utils/error.util';

export class AuditHandler {
  /**
   * GET /api/admin/audit-logs
   * Get audit logs filtered by entityType and entityId
   * Query params: entityType, entityId, limit, offset
   * Admin-only
   */
  getAuditLogs = async (req: Request, res: Response): Promise<void> => {
    try {
      const adminId = req.user?.userId;
      if (!adminId) {
        res.status(401).json({ success: false, error: 'Unauthorized' });
        return;
      }

      const { entityType, entityId, limit, offset } = req.query;
      const branchId = req.user?.branchId;

      // Validate required params
      if (!entityType || typeof entityType !== 'string') {
        res.status(400).json({ 
          success: false, 
          error: 'entityType is required (e.g., entityType=booking)' 
        });
        return;
      }

      if (!entityId || typeof entityId !== 'string') {
        res.status(400).json({ 
          success: false, 
          error: 'entityId is required (e.g., entityId=uuid-of-booking)' 
        });
        return;
      }

      const limitNum = limit ? parseInt(limit as string, 10) : 100;
      const offsetNum = offset ? parseInt(offset as string, 10) : 0;

      // Get logs for the specific entity
      const logs = await auditService.getEventsByEntity(
        entityType,
        entityId,
        limitNum,
        offsetNum
      );

      // Filter by branch if admin has branch restriction (multi-tenant)
      const filteredLogs = branchId 
        ? logs.filter(log => log.branch_id === branchId)
        : logs;

      res.status(200).json({
        success: true,
        data: {
          logs: filteredLogs,
          pagination: {
            limit: limitNum,
            offset: offsetNum,
            total: filteredLogs.length,
          },
        },
      });
    } catch (error: unknown) {
      const message = getErrorMessage(error);
      const stack = getErrorStack(error);
      logger.error({ error: message, stack });
      res.status(500).json({ 
        success: false, 
        error: 'INTERNAL_SERVER_ERROR', 
        message: 'Server error' 
      });
    }
  };
}
