import 'dotenv/config';
import express, { Express } from 'express';
import cors from 'cors';
import helmet from 'helmet';
import { config } from './config';
import { logger } from './utils/logger';
import { errorHandler } from './middleware/errorHandler';
import { rateLimiter } from './middleware/rateLimiter';
import { requestLoggerMiddleware } from './middleware/requestLogger';
import { authMiddleware } from './middleware/authMiddleware';
import { tenantMiddleware } from './middleware/tenant.middleware';

// Import routes
import authRoutes from './routes/auth.routes';
import healthRoutes from './routes/health.routes';
import webhookRoutes from './routes/webhook.routes';

// Import job scheduler
import { jobScheduler } from './jobs/jobScheduler';

const app: Express = express();
const PORT = config.server.port;

// ============================================
// CORS Configuration (Development)
// ============================================
const corsOptions = {
  origin: [
    'http://localhost:3000',   // Web frontend
    'http://localhost:3001',   // Admin dashboard
    'http://localhost:3002',   // Doctor portal
    'http://localhost:3003',   // Mobile web (optional)
    'http://localhost:8080',   // TV display
    'http://127.0.0.1:3000',
    'http://127.0.0.1:3001',
  ],
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization', 'X-Requested-With'],
  credentials: true,
  optionsSuccessStatus: 200,
};

// ============================================
// Middleware (Urutan Penting!)
// ============================================
app.use(helmet()); // Security headers
app.use(cors(corsOptions)); // CORS
app.use(express.json({ limit: '1mb' })); // JSON parser
app.use(rateLimiter); // Rate limiting (5 req/sec)
app.use(requestLoggerMiddleware); // Request logging

// ============================================
// Public Routes (No Auth)
// ============================================
app.use('/health', healthRoutes);
app.use('/webhooks', webhookRoutes);
app.use('/auth', authRoutes);

// ============================================
// Protected Routes (Auth + Tenant)
// ============================================
// Apply auth and tenant middleware to all other routes
// For now, we just have the middleware ready.
// Future routes (e.g., /api/patients, /api/bookings) will be added here.

// ============================================
// Error Handling
// ============================================
// Handle invalid JSON (syntax error)
app.use((err: any, req: express.Request, res: express.Response, next: express.NextFunction) => {
  if (err instanceof SyntaxError && 'body' in err) {
    return res.status(400).json({
      success: false,
      message: 'Invalid JSON payload',
      error: {
        code: 'INVALID_JSON',
      },
    });
  }
  next(err);
});

// Global error handler (must be last)
app.use(errorHandler);

// ============================================
// Start Server
// ============================================
app.listen(PORT, () => {
  logger.info(`✅ DentFlow API starting on port ${PORT}`);
  logger.info(`   Environment: ${config.server.nodeEnv}`);
  logger.info(`   Database: ${config.database.url}`);
  logger.info(`   Redis: ${config.redis.url}`);
  logger.info(`   MinIO: ${config.minio.endpoint}`);
  
  // Initialize job scheduler
  jobScheduler.initialize();
});
