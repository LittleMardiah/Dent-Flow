import { Pool } from 'pg';
import { config } from '../config';
import { logger } from '../utils/logger';
import { auditService } from './audit.service';
import { AuditEventType } from '../models/audit.model';

export class EncounterService {
  private pool: Pool;

  constructor() {
    this.pool = new Pool({ connectionString: config.database.url });
  }

  /**
   * Start a new encounter for a booking (patient check-in by doctor)
   */
  async startEncounter(
    bookingId: string,
    doctorId: string,
    branchId: string
  ): Promise<any> {
    const client = await this.pool.connect();
    try {
      await client.query('BEGIN');

      // 1. Check if booking exists and is valid (CHECKED_IN or PAYMENT_CONFIRMED)
      const bookingResult = await client.query(
        `SELECT id, patient_id FROM bookings 
         WHERE id = $1 AND status IN ('CHECKED_IN', 'PAYMENT_CONFIRMED')`,
        [bookingId]
      );
      if (bookingResult.rows.length === 0) {
        throw new Error('BOOKING_NOT_VALID_FOR_ENCOUNTER');
      }
      const booking = bookingResult.rows[0];

      // 2. Check if encounter already exists for this booking
      const existingEncounter = await client.query(
        'SELECT id FROM encounters WHERE booking_id = $1',
        [bookingId]
      );
      if (existingEncounter.rows.length > 0) {
        throw new Error('ENCOUNTER_ALREADY_EXISTS');
      }

      // 3. Get patient_id from booking
      const patientId = booking.patient_id;

      // 4. Create encounter
      const result = await client.query(
        `INSERT INTO encounters (
          id, branch_id, booking_id, doctor_id, patient_id, status, started_at
        ) VALUES (
          gen_random_uuid(), $1, $2, $3, $4, 'IN_PROGRESS', NOW()
        ) RETURNING *`,
        [branchId, bookingId, doctorId, patientId]
      );
      const encounter = result.rows[0];

      // 5. Audit log
      await auditService.logEvent({
        branchId,
        userId: doctorId,
        eventType: AuditEventType.ENCOUNTER_STARTED,
        entityType: 'ENCOUNTER',
        entityId: encounter.id,
        description: `Encounter started for booking ${bookingId} by doctor ${doctorId}`,
        newValues: {
          status: 'IN_PROGRESS',
          started_at: encounter.started_at,
        },
      });

      await client.query('COMMIT');
      logger.info(`✅ Encounter ${encounter.id} started for booking ${bookingId}`);
      return encounter;
    } catch (error: any) {
      await client.query('ROLLBACK');
      logger.error({ error: error.message, stack: error.stack }, 'Failed to start encounter');
      throw error;
    } finally {
      client.release();
    }
  }

  /**
   * Record or update diagnosis for an encounter
   */
  async recordDiagnosis(
    encounterId: string,
    diagnosis: string,
    icd10Code?: string
  ): Promise<void> {
    const client = await this.pool.connect();
    try {
      // Build diagnosis string with ICD-10 if provided
      let diagnosisText = diagnosis;
      if (icd10Code) {
        diagnosisText = `${diagnosis} (ICD-10: ${icd10Code})`;
      }

      await client.query(
        `UPDATE encounters 
         SET diagnosis = $1, updated_at = NOW()
         WHERE id = $2 AND status != 'COMPLETED'`,
        [diagnosisText, encounterId]
      );
      logger.info(`✅ Diagnosis recorded for encounter ${encounterId}`);
    } catch (error: any) {
      logger.error({ error: error.message, stack: error.stack }, 'Failed to record diagnosis');
      throw error;
    } finally {
      client.release();
    }
  }

  /**
   * Record or update treatment for an encounter
   */
  async recordTreatment(
    encounterId: string,
    treatment: string,
    notes?: string
  ): Promise<void> {
    const client = await this.pool.connect();
    try {
      await client.query(
        `UPDATE encounters 
         SET treatment = $1, notes = COALESCE($2, notes), updated_at = NOW()
         WHERE id = $3 AND status != 'COMPLETED'`,
        [treatment, notes, encounterId]
      );
      logger.info(`✅ Treatment recorded for encounter ${encounterId}`);
    } catch (error: any) {
      logger.error({ error: error.message, stack: error.stack }, 'Failed to record treatment');
      throw error;
    } finally {
      client.release();
    }
  }

  /**
   * Complete encounter (trigger invoice generation via trigger)
   */
  async completeEncounter(encounterId: string, doctorId: string): Promise<any> {
    const client = await this.pool.connect();
    try {
      await client.query('BEGIN');

      // 1. Verify encounter exists and is IN_PROGRESS
      const encounterResult = await client.query(
        `SELECT id, branch_id, status FROM encounters 
         WHERE id = $1 AND doctor_id = $2`,
        [encounterId, doctorId]
      );
      if (encounterResult.rows.length === 0) {
        throw new Error('ENCOUNTER_NOT_FOUND_OR_NOT_OWNED');
      }
      const encounter = encounterResult.rows[0];
      if (encounter.status === 'COMPLETED') {
        throw new Error('ENCOUNTER_ALREADY_COMPLETED');
      }

      // 2. Update status to COMPLETED (triggers invoice generation automatically)
      const updateResult = await client.query(
        `UPDATE encounters 
         SET status = 'COMPLETED', completed_at = NOW(), updated_at = NOW()
         WHERE id = $1
         RETURNING *`,
        [encounterId]
      );
      const updated = updateResult.rows[0];

      // 3. Audit log
      await auditService.logEvent({
        branchId: updated.branch_id,
        userId: doctorId,
        eventType: AuditEventType.ENCOUNTER_COMPLETED,
        entityType: 'ENCOUNTER',
        entityId: updated.id,
        description: `Encounter ${encounterId} completed by doctor ${doctorId}`,
        newValues: {
          status: 'COMPLETED',
          completed_at: updated.completed_at,
        },
        oldValues: {
          status: 'IN_PROGRESS',
        },
      });

      await client.query('COMMIT');
      logger.info(`✅ Encounter ${encounterId} completed`);

      // 4. Fetch invoice that was auto-generated (if any)
      const invoiceResult = await client.query(
        'SELECT * FROM invoices WHERE encounter_id = $1',
        [encounterId]
      );
      const invoice = invoiceResult.rows[0] || null;

      return { encounter: updated, invoice };
    } catch (error: any) {
      await client.query('ROLLBACK');
      logger.error({ error: error.message, stack: error.stack }, 'Failed to complete encounter');
      throw error;
    } finally {
      client.release();
    }
  }

  /**
   * Get encounter detail with authorization check
   */
  async getEncounterById(encounterId: string, userId: string, role: string): Promise<any> {
    const result = await this.pool.query(
      `SELECT e.*, 
        b.booking_code,
        u.full_name as doctor_name,
        p.full_name as patient_name
       FROM encounters e
       LEFT JOIN bookings b ON e.booking_id = b.id
       LEFT JOIN users u ON e.doctor_id = u.id
       LEFT JOIN patients p ON e.patient_id = p.id
       WHERE e.id = $1`,
      [encounterId]
    );
    if (result.rows.length === 0) {
      throw new Error('ENCOUNTER_NOT_FOUND');
    }
    const encounter = result.rows[0];

    // Authorization: patient can view own, doctor can view own, admin can view all
    if (role === 'PATIENT' && encounter.patient_id !== userId) {
      throw new Error('FORBIDDEN');
    }
    if (role === 'DOCTOR' && encounter.doctor_id !== userId) {
      throw new Error('FORBIDDEN');
    }
    // Admin can view all (already allowed)

    return encounter;
  }

  /**
   * Update encounter fields (diagnosis, treatment, notes) - generic update
   */
  async updateEncounter(
    encounterId: string,
    doctorId: string,
    updates: {
      diagnosis?: string;
      treatment?: string;
      notes?: string;
      prescription?: string;
      chief_complaint?: string;
    }
  ): Promise<any> {
    const client = await this.pool.connect();
    try {
      // Build dynamic SET clause
      const setClauses: string[] = [];
      const values: any[] = [];
      let paramCounter = 1;

      const fields = ['diagnosis', 'treatment', 'notes', 'prescription', 'chief_complaint'];
      for (const field of fields) {
        if (updates[field as keyof typeof updates] !== undefined) {
          setClauses.push(`${field} = $${paramCounter}`);
          values.push(updates[field as keyof typeof updates]);
          paramCounter++;
        }
      }

      if (setClauses.length === 0) {
        throw new Error('NO_FIELDS_TO_UPDATE');
      }

      setClauses.push(`updated_at = NOW()`);
      values.push(encounterId);
      values.push(doctorId);

      const query = `
        UPDATE encounters 
        SET ${setClauses.join(', ')}
        WHERE id = $${paramCounter} AND doctor_id = $${paramCounter + 1} AND status != 'COMPLETED'
        RETURNING *
      `;
      const result = await client.query(query, values);
      if (result.rows.length === 0) {
        throw new Error('ENCOUNTER_NOT_FOUND_OR_NOT_OWNED_OR_COMPLETED');
      }
      logger.info(`✅ Encounter ${encounterId} updated`);
      return result.rows[0];
    } catch (error: any) {
      logger.error({ error: error.message, stack: error.stack }, 'Failed to update encounter');
      throw error;
    } finally {
      client.release();
    }
  }
}
