  async cancelBooking(bookingId: string, userId: string): Promise<Booking> {
    const patientId = await this.getPatientIdFromUserId(userId);
    const owned = await this.repo.isOwnedByPatient(bookingId, patientId);
    if (!owned) throw new Error('BOOKING_NOT_OWNED');

    const booking = await this.repo.findById(bookingId);
    if (!booking) throw new Error('BOOKING_NOT_FOUND');
    // Prevent cancellation if already completed, no-show, or cancelled
    if (booking.status === 'COMPLETED' || booking.status === 'NO_SHOW' || booking.status === 'CANCELLED') {
      throw new Error('BOOKING_CANNOT_CANCEL');
    }

    const updated = await this.repo.softDelete(bookingId);
    if (!updated) throw new Error('BOOKING_CANNOT_CANCEL');

    await auditService.logEvent({
      branchId: updated.branch_id,
      userId: userId,
      eventType: AuditEventType.BOOKING_CANCELLED,
      entityType: 'BOOKING',
      entityId: updated.id,
      description: `Booking ${updated.booking_code} dibatalkan`,
      oldValues: { status: booking.status },
      newValues: { status: 'CANCELLED', cancelled_at: updated.cancelled_at },
    });

    return updated;
  }
