import { Pool } from 'pg';
import { config } from '../config';
import { logger } from '../utils/logger';
import redis from '../config/redis';
import { auditService } from './audit.service';
import { AuditEventType } from '../models/audit.model';

export class CheckinService {
  private pool: Pool;

  constructor() {
    this.pool = new Pool({ connectionString: config.database.url });
  }

  /**
   * Admin check-in pasien dengan kode booking
   * @param checkInCode - 6-digit alphanumeric booking code
   * @param branchId - branch ID (untuk validasi)
   * @param adminId - admin user ID (untuk audit log)
   */
  async checkinPatient(checkInCode: string, branchId: string, adminId: string) {
    const client = await this.pool.connect();
    try {
      await client.query('BEGIN');

      // 1. Cek booking berdasarkan kode
      const bookingResult = await client.query(
        `SELECT b.id, b.status, b.pasien_id, b.dokter_id, b.session_start, b.session_end, 
                b.payment_status, b.checked_in_at, b.branch_id
         FROM bookings b
         WHERE b.check_in_code = $1 AND b.deleted_at IS NULL`,
        [checkInCode]
      );

      if (bookingResult.rows.length === 0) {
        throw new Error('KODE_TIDAK_VALID');
      }

      const booking = bookingResult.rows[0];

      // 2. Validasi branch
      if (booking.branch_id !== branchId) {
        throw new Error('BRANCH_TIDAK_SESUAI');
      }

      // 3. Validasi status booking
      if (booking.status !== 'PAYMENT_CONFIRMED' && booking.status !== 'CONFIRMED') {
        throw new Error('STATUS_TIDAK_VALID');
      }

      // 4. Validasi pembayaran
      if (booking.payment_status !== 'CONFIRMED') {
        throw new Error('PAYMENT_BELUM_KONFIRMASI');
      }

      // 5. Cek apakah sudah check-in
      if (booking.checked_in_at) {
        // Sudah check-in, return existing queue number
        const existingQueue = await client.query(
          `SELECT queue_number FROM queues WHERE booking_id = $1 AND status != 'COMPLETED'`,
          [booking.id]
        );
        if (existingQueue.rows.length > 0) {
          return {
            alreadyCheckedIn: true,
            queueNumber: existingQueue.rows[0].queue_number,
          };
        }
        throw new Error('SUDAH_CHECK_IN');
      }

      // 6. Validasi sesi (pastikan hari ini dan dalam waktu sesi)
      const now = new Date();
      const sessionStart = new Date(booking.session_start);
      const sessionEnd = new Date(booking.session_end);

      if (now < sessionStart) {
        throw new Error('SESI_BELUM_DIMULAI');
      }
      if (now > sessionEnd) {
        throw new Error('SESI_SUDAH_BERAKHIR');
      }

      // 7. Generate queue number via Redis atomic counter
      const doctorId = booking.dokter_id;
      const queueDate = now.toISOString().split('T')[0]; // YYYY-MM-DD
      const redisKey = `queue:${branchId}:${doctorId}:${queueDate}`;
      const queueNumber = await redis.incr(redisKey);

      // 8. Create queue record
      const queueResult = await client.query(
        `INSERT INTO queues (branch_id, booking_id, dokter_id, queue_number, queue_date, status, check_in_time)
         VALUES ($1, $2, $3, $4, $5, 'WAITING', $6)
         RETURNING id`,
        [branchId, booking.id, doctorId, queueNumber, queueDate, now]
      );

      // 9. Update booking status
      await client.query(
        `UPDATE bookings 
         SET status = 'CHECKED_IN', checked_in_at = $1, queue_number = $2, updated_at = NOW()
         WHERE id = $3`,
        [now, queueNumber, booking.id]
      );

      // 10. Audit log
      await auditService.logEvent({
        branchId,
        userId: adminId,
        eventType: AuditEventType.BOOKING_CHECKED_IN,
        entityType: 'BOOKING',
        entityId: booking.id,
        description: `Admin check-in pasien dengan kode ${checkInCode}, queue number ${queueNumber}`,
      });

      await client.query('COMMIT');

      return {
        alreadyCheckedIn: false,
        queueNumber,
        bookingId: booking.id,
        patientId: booking.pasien_id,
        doctorId: booking.dokter_id,
      };
    } catch (error: any) {
      await client.query('ROLLBACK');
      logger.error({ error: error.message, checkInCode, branchId }, 'Check-in failed');
      throw error;
    } finally {
      client.release();
    }
  }
}

export const checkinService = new CheckinService();
