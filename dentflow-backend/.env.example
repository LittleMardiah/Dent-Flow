# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL) - Port 5432
DATABASE_URL=postgresql://dentflow_user:dentflow_password@localhost:5432/dentflow

# Redis - Port 6380 (SESUAI DENGAN DOCKER COMPOSE LO)
REDIS_URL=redis://localhost:6380

# MinIO - Port 9002 (SESUAI DENGAN DOCKER COMPOSE LO)
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dentflow

# JWT (Ganti dengan secret yang kuat di file .env asli)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=info

# Testing (Opsional, untuk database test terpisah)
TEST_DATABASE_URL=postgresql://dentflow_user:dentflow_password@localhost:5432/dentflow_test

# NO-SHOW Detection
NO_SHOW_GRACE_MINUTES=15
