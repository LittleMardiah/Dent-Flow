import { PaymentInputService } from '../../../src/services/paymentInput.service';
import { InvoicePaymentService } from '../../../src/services/invoicePayment.service';

// Mock InvoicePaymentService
jest.mock('../../../src/services/invoicePayment.service');

// Mock pg Pool
const mockQuery = jest.fn();
const mockRelease = jest.fn();
const mockConnect = jest.fn().mockResolvedValue({
  query: mockQuery,
  release: mockRelease,
});

jest.mock('pg', () => {
  return {
    Pool: jest.fn().mockImplementation(() => ({
      connect: mockConnect,
      query: mockQuery,
      end: jest.fn(),
    })),
  };
});

describe('PaymentInputService', () => {
  let service: PaymentInputService;
  let mockInvoicePaymentService: jest.Mocked<InvoicePaymentService>;

  beforeEach(() => {
    jest.clearAllMocks();
    service = new PaymentInputService();
    mockInvoicePaymentService = new InvoicePaymentService() as jest.Mocked<InvoicePaymentService>;
    // Inject mock
    (service as any).invoicePaymentService = mockInvoicePaymentService;
  });

  describe('parseOrderId', () => {
    it('should parse full UUID format correctly', () => {
      const result = service.parseOrderId('INV-494a607c-d109-4330-a3a9-68f54326f0c7-20260722-001');
      expect(result).toEqual({
        branchId: '494a607c-d109-4330-a3a9-68f54326f0c7',
        dateStr: '20260722',
        seq: '001',
      });
    });

    it('should return null for invalid format', () => {
      expect(service.parseOrderId('INV-123')).toBeNull();
      expect(service.parseOrderId('INV-123-456')).toBeNull();
      expect(service.parseOrderId('INV-branch-20260722-001')).toBeNull(); // no hyphens in branch
    });

    it('should return null if not starting with INV', () => {
      expect(service.parseOrderId('BOOK-123-456-789')).toBeNull();
    });
  });

  describe('processPaymentInput', () => {
    const webhookData = {
      order_id: 'INV-494a607c-d109-4330-a3a9-68f54326f0c7-20260722-001',
      gross_amount: 100000,
      payment_type: 'credit_card',
      status: 'settlement',
      transaction_id: 'txn-123',
    };
    const webhookId = 'wh-123';

    it('should process payment successfully for settlement status', async () => {
      // Mock invoice found
      mockQuery.mockResolvedValueOnce({ rows: [{ id: 'inv-1', amount_due: '100000', invoice_number: 'INV-...' }] });
      // Mock markInvoicePaid
      mockInvoicePaymentService.markInvoicePaid.mockResolvedValue({ id: 'inv-1', status: 'PAID' });

      const result = await service.processPaymentInput(webhookData, webhookId);

      expect(result.success).toBe(true);
      expect(result.message).toBe('Payment processed successfully');
      expect(result.data).toHaveProperty('id', 'inv-1');
      expect(mockInvoicePaymentService.markInvoicePaid).toHaveBeenCalledWith(
        'inv-1',
        'credit_card',
        'txn-123',
        expect.any(String),
        100000
      );
    });

    it('should return false if invoice not found', async () => {
      mockQuery.mockResolvedValueOnce({ rows: [] });
      mockQuery.mockResolvedValueOnce({ rows: [] }); // Second try

      const result = await service.processPaymentInput(webhookData, webhookId);

      expect(result.success).toBe(false);
      expect(result.message).toBe('Invoice not found');
      expect(mockInvoicePaymentService.markInvoicePaid).not.toHaveBeenCalled();
    });

    it('should return false if amount mismatch', async () => {
      mockQuery.mockResolvedValueOnce({ rows: [{ id: 'inv-1', amount_due: '150000' }] });

      const result = await service.processPaymentInput(webhookData, webhookId);

      expect(result.success).toBe(false);
      expect(result.message).toContain('Amount mismatch');
      expect(mockInvoicePaymentService.markInvoicePaid).not.toHaveBeenCalled();
    });

    it('should handle deny/expire status without marking paid', async () => {
      const webhookDataDeny = { ...webhookData, status: 'deny' };
      mockQuery.mockResolvedValueOnce({ rows: [{ id: 'inv-1', amount_due: '100000' }] });

      const result = await service.processPaymentInput(webhookDataDeny, webhookId);

      expect(result.success).toBe(true);
      expect(result.message).toBe('Payment deny');
      expect(mockInvoicePaymentService.markInvoicePaid).not.toHaveBeenCalled();
    });

    it('should handle pending status without marking paid', async () => {
      const webhookDataPending = { ...webhookData, status: 'pending' };
      mockQuery.mockResolvedValueOnce({ rows: [{ id: 'inv-1', amount_due: '100000' }] });

      const result = await service.processPaymentInput(webhookDataPending, webhookId);

      expect(result.success).toBe(true);
      expect(result.message).toBe('Payment pending');
      expect(mockInvoicePaymentService.markInvoicePaid).not.toHaveBeenCalled();
    });

    it('should handle unknown status gracefully', async () => {
      const webhookDataUnknown = { ...webhookData, status: 'unknown' };
      mockQuery.mockResolvedValueOnce({ rows: [{ id: 'inv-1', amount_due: '100000' }] });

      const result = await service.processPaymentInput(webhookDataUnknown, webhookId);

      expect(result.success).toBe(false);
      expect(result.message).toBe('Unknown status: unknown');
      expect(mockInvoicePaymentService.markInvoicePaid).not.toHaveBeenCalled();
    });
  });

  describe('getReconciliation', () => {
    it('should return reconciliation data for a date', async () => {
      const mockRows = [
        { invoice_id: 'inv-1', invoice_number: 'INV-001', amount_due: '100000', invoice_status: 'PAID' },
        { invoice_id: 'inv-2', invoice_number: 'INV-002', amount_due: '200000', invoice_status: 'UNPAID' },
      ];
      mockQuery.mockResolvedValueOnce({ rows: mockRows });

      const result = await service.getReconciliation(new Date('2026-07-22'));

      expect(result).toHaveLength(2);
      expect(result[0]).toHaveProperty('invoice_id', 'inv-1');
      expect(result[1]).toHaveProperty('invoice_status', 'UNPAID');
      expect(mockQuery).toHaveBeenCalledWith(
        expect.stringContaining('SELECT'),
        ['2026-07-22']
      );
    });

    it('should return empty array if no data', async () => {
      mockQuery.mockResolvedValueOnce({ rows: [] });

      const result = await service.getReconciliation(new Date('2026-07-22'));
      expect(result).toEqual([]);
    });
  });

  describe('getReconciliationSummary', () => {
    it('should return summary for date range', async () => {
      const mockSummary = {
        total_invoices: 10,
        total_amount: '1000000',
        total_paid: '800000',
        unpaid_count: 2,
      };
      mockQuery.mockResolvedValueOnce({ rows: [mockSummary] });

      const result = await service.getReconciliationSummary('2026-07-01', '2026-07-31');

      expect(result).toHaveProperty('total_invoices', 10);
      expect(result).toHaveProperty('total_amount', '1000000');
      expect(result).toHaveProperty('total_paid', '800000');
      expect(result).toHaveProperty('unpaid_count', 2);
      expect(mockQuery).toHaveBeenCalledWith(
        expect.stringContaining('SELECT'),
        ['2026-07-01', '2026-07-31']
      );
    });

    it('should return zero summary if no data', async () => {
      mockQuery.mockResolvedValueOnce({ rows: [{ total_invoices: 0, total_amount: 0, total_paid: 0, unpaid_count: 0 }] });

      const result = await service.getReconciliationSummary('2026-07-01', '2026-07-31');

      expect(result.total_invoices).toBe(0);
      expect(result.total_amount).toBe(0);
    });
  });
});
