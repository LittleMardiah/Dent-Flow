import request from 'supertest';
import { Pool } from 'pg';
import { config } from '../../src/config';
import { app } from '../../src/index';

describe('Phase 1 Completion Tests', () => {
  let pool: Pool;

  beforeAll(async () => {
    pool = new Pool({ connectionString: config.database.url });
    console.log('✅ Test database connected');
  });

  afterAll(async () => {
    await pool.end();
    console.log('✅ Test database disconnected');
  });

  // ============================================
  // DATABASE
  // ============================================
  describe('Database Connection & Schema', () => {
    test('Should connect to database', async () => {
      const result = await pool.query('SELECT 1 AS value');
      expect(result.rows[0]).toBeDefined();
      expect(result.rows[0].value).toBe(1);
    });

    test('Should have at least 11 tables', async () => {
      const result = await pool.query(
        `SELECT count(*) FROM information_schema.tables 
         WHERE table_schema = 'public' AND table_type = 'BASE TABLE'`
      );
      const count = parseInt(result.rows[0].count);
      expect(count).toBeGreaterThanOrEqual(11);
    });
  });

  // ============================================
  // HEALTH
  // ============================================
  describe('Health Check', () => {
    test('GET /health returns 200', async () => {
      const res = await request(app).get('/health');
      expect(res.status).toBe(200);
      expect(res.body).toHaveProperty('services');
    });
  });

  // ============================================
  // AUTH - REGISTER
  // ============================================
  describe('Auth Flow - Register', () => {
    const email = `test_${Date.now()}@example.com`;
    let token: string;

    test('Register patient should return 201', async () => {
      const res = await request(app)
        .post('/auth/patient/register')
        .send({
          email,
          password: 'Test1234!',
          fullName: 'Test User',
          phone: '08123456789',
        });
      expect(res.status).toBe(201);
      expect(res.body.data).toHaveProperty('token');
      token = res.body.data.token;
    });

    test('Duplicate email should return 400', async () => {
      const res = await request(app)
        .post('/auth/patient/register')
        .send({
          email,
          password: 'Test1234!',
          fullName: 'Test User',
        });
      expect(res.status).toBe(400);
      expect(res.body.message).toMatch(/email already/i);
    });
  });

  // ============================================
  // AUTH - LOGIN
  // ============================================
  describe('Admin Login', () => {
    test('Correct credentials -> 200', async () => {
      const res = await request(app)
        .post('/auth/admin/login')
        .send({ username: 'admin_001', password: 'Admin123!' });
      expect(res.status).toBe(200);
      expect(res.body.data.user.role).toBe('ADMIN_BRANCH');
    });

    test('Wrong password -> 401', async () => {
      const res = await request(app)
        .post('/auth/admin/login')
        .send({ username: 'admin_001', password: 'wrong' });
      expect(res.status).toBe(401);
    });
  });

  describe('Doctor Login', () => {
    test('Correct credentials -> 200', async () => {
      const res = await request(app)
        .post('/auth/doctor/login')
        .send({ username: 'dr_general_a', password: 'Doctor123!' });
      expect(res.status).toBe(200);
      expect(res.body.data.user.role).toBe('DOCTOR');
    });
  });

  // ============================================
  // FORGOT PASSWORD
  // ============================================
  describe('Forgot Password', () => {
    test('Valid email returns 200', async () => {
      const res = await request(app)
        .post('/auth/forgot-password')
        .send({ email: 'patient@test.com' });
      
      // Just check status is 200, don't check devToken (it's development-only)
      expect(res.status).toBe(200);
      expect(res.body).toHaveProperty('message');
    });
  });

  // ============================================
  // WEBHOOK
  // ============================================
  describe('Webhook Idempotency', () => {
    const payload = {
      provider: 'midtrans',
      transaction_id: `txn_${Date.now()}`,
      order_id: `order_${Date.now()}`,
      transaction_status: 'settlement',
      signature_key: 'dummy',
    };

    test('First webhook stored', async () => {
      const res = await request(app)
        .post('/webhooks/payment')
        .send(payload);
      expect(res.status).toBe(200);
      expect(res.body).toHaveProperty('id');
    });

    test('Duplicate webhook returns idempotent', async () => {
      const res = await request(app)
        .post('/webhooks/payment')
        .send(payload);
      expect(res.status).toBe(200);
      expect(res.body.message).toMatch(/idempotent|already processed/i);
    });
  });

  // ============================================
  // AUDIT LOG
  // ============================================
  describe('Audit Log', () => {
    test('Has entries', async () => {
      const res = await pool.query('SELECT count(*) FROM audit_logs');
      expect(parseInt(res.rows[0].count)).toBeGreaterThanOrEqual(0);
    });
  });

  // ============================================
  // RATE LIMITING
  // ============================================
  describe('Rate Limiting', () => {
    test('Rate limiter disabled in test environment', () => {
      expect(process.env.NODE_ENV).toBe('test');
    });
  });
});
