import request from 'supertest';
import { app } from '../../src/index';
import { pool } from '../../src/config/database';
import { redis } from '../../src/config/redis';
import bcrypt from 'bcryptjs';

describe('Booking & Queue Integration Tests', () => {
  let patientToken: string;
  let adminToken: string;
  let bookingId: string;
  let bookingCode: string;

  const TEST_PATIENT_USERNAME = 'budi_santoso';
  const TEST_PATIENT_PASSWORD = 'Patient123!';
  const TEST_ADMIN_USERNAME = 'admin_a';
  const TEST_ADMIN_PASSWORD = 'Admin123!';
  const TEST_DOCTOR_USER_ID = '965dedad-11ba-46a3-a402-f88c2029c676';

  let branchId: string;

  const query = async (text: string, params?: any[]) => pool.query(text, params);

  // Helper: add column if not exists
  const ensureColumn = async (table: string, column: string, definition: string) => {
    const check = await query(`
      SELECT EXISTS (
        SELECT FROM information_schema.columns 
        WHERE table_name = $1 AND column_name = $2
      );
    `, [table, column]);
    if (!check.rows[0].exists) {
      await query(`ALTER TABLE ${table} ADD COLUMN ${column} ${definition}`);
      console.log(`✅ Added column ${table}.${column}`);
    }
  };

  beforeAll(async () => {
    // ===== Ensure required columns in bookings table =====
    await ensureColumn('bookings', 'temp_profile_flag', 'BOOLEAN DEFAULT FALSE');
    await ensureColumn('bookings', 'queue_number', 'INTEGER');
    await ensureColumn('bookings', 'cancelled_at', 'TIMESTAMP');
    await ensureColumn('bookings', 'cancelled_reason', 'VARCHAR(255)');
    await ensureColumn('bookings', 'session_start', 'TIMESTAMP');
    await ensureColumn('bookings', 'session_end', 'TIMESTAMP');
    await ensureColumn('bookings', 'patient_notes', 'TEXT');

    // ===== Ensure doctor_schedules table =====
    const tableCheck = await query(`
      SELECT EXISTS (
        SELECT FROM information_schema.tables 
        WHERE table_name = 'doctor_schedules'
      );
    `);
    if (!tableCheck.rows[0].exists) {
      await query(`
        CREATE TABLE doctor_schedules (
          id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
          branch_id UUID NOT NULL REFERENCES branches(id) ON DELETE RESTRICT,
          dokter_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
          day_of_week INTEGER NOT NULL CHECK (day_of_week BETWEEN 0 AND 6),
          session_start TIME NOT NULL,
          session_end TIME NOT NULL,
          max_patients_per_session INTEGER DEFAULT 4,
          is_active BOOLEAN DEFAULT TRUE,
          created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
          updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        CREATE INDEX idx_doctor_schedules_dokter_id ON doctor_schedules(dokter_id);
        CREATE INDEX idx_doctor_schedules_branch_id ON doctor_schedules(branch_id);
        CREATE INDEX idx_doctor_schedules_day ON doctor_schedules(day_of_week);
      `);
      console.log('✅ Created doctor_schedules table');
    }

    // ===== Seed data =====
    // 1. Branch
    const branchRes = await query('SELECT id FROM branches LIMIT 1');
    if (branchRes.rows.length > 0) {
      branchId = branchRes.rows[0].id;
    } else {
      const newBranch = await query(
        `INSERT INTO branches (id, name, phone, address, is_active)
         VALUES (gen_random_uuid(), 'Cabang Test', '021-1234567', 'Jl. Test', true)
         RETURNING id`
      );
      branchId = newBranch.rows[0].id;
    }

    // 2. Patient user
    const uniqueEmail = `patient_${Date.now()}_${Math.random().toString(36).substring(7)}@test.com`;
    const patientHashed = await bcrypt.hash(TEST_PATIENT_PASSWORD, 10);
    await query(
      `INSERT INTO users (id, branch_id, role, email, username, password_hash)
       VALUES (gen_random_uuid(), $1, 'PATIENT', $2, $3, $4)
       ON CONFLICT (username) DO NOTHING`,
      [branchId, uniqueEmail, TEST_PATIENT_USERNAME, patientHashed]
    );
    const patientUser = await query(
      'SELECT id FROM users WHERE username = $1',
      [TEST_PATIENT_USERNAME]
    );
    if (patientUser.rows.length > 0) {
      const patientId = patientUser.rows[0].id;
      await query(
        `INSERT INTO patients (id, branch_id, user_id, full_name, phone)
         VALUES (gen_random_uuid(), $1, $2, 'Test Patient', '08123456789')
         ON CONFLICT (user_id) DO NOTHING`,
        [branchId, patientId]
      );
    }

    // 3. Admin
    const adminHashed = await bcrypt.hash(TEST_ADMIN_PASSWORD, 10);
    await query(
      `INSERT INTO users (id, branch_id, role, email, username, password_hash)
       VALUES (gen_random_uuid(), $1, 'ADMIN_BRANCH', 'admin_test@clinic.com', $2, $3)
       ON CONFLICT (username) DO NOTHING`,
      [branchId, TEST_ADMIN_USERNAME, adminHashed]
    );

    // 4. Doctor user
    const doctorHashed = await bcrypt.hash('Doctor123!', 10);
    await query(
      `INSERT INTO users (id, branch_id, role, email, username, password_hash)
       VALUES ($1, $2, 'DOCTOR', 'dr_bm_a@clinic.com', 'dr_bm_a', $3)
       ON CONFLICT (id) DO NOTHING`,
      [TEST_DOCTOR_USER_ID, branchId, doctorHashed]
    );
    await query(
      `INSERT INTO doctors (id, branch_id, user_id, full_name, specialization, license_number, is_available)
       VALUES (gen_random_uuid(), $1, $2, 'drg. Siti Nurhaliza', 'Sp.BM', 'LIC-001', true)
       ON CONFLICT (user_id) DO NOTHING`,
      [branchId, TEST_DOCTOR_USER_ID]
    );

    // 5. Doctor schedules for ALL weekdays (1-6) — pagi & sore
    const allDays = [1, 2, 3, 4, 5, 6];
    for (const day of allDays) {
      const existing = await query(
        `SELECT id FROM doctor_schedules WHERE dokter_id = $1 AND day_of_week = $2 AND session_start = '09:00'`,
        [TEST_DOCTOR_USER_ID, day]
      );
      if (existing.rows.length === 0) {
        await query(
          `INSERT INTO doctor_schedules (id, branch_id, dokter_id, day_of_week, session_start, session_end, max_patients_per_session, is_active)
           VALUES (gen_random_uuid(), $1, $2, $3, '09:00', '12:00', 4, true)`,
          [branchId, TEST_DOCTOR_USER_ID, day]
        );
      }
      const existingAfternoon = await query(
        `SELECT id FROM doctor_schedules WHERE dokter_id = $1 AND day_of_week = $2 AND session_start = '13:00'`,
        [TEST_DOCTOR_USER_ID, day]
      );
      if (existingAfternoon.rows.length === 0) {
        await query(
          `INSERT INTO doctor_schedules (id, branch_id, dokter_id, day_of_week, session_start, session_end, max_patients_per_session, is_active)
           VALUES (gen_random_uuid(), $1, $2, $3, '13:00', '16:00', 4, true)`,
          [branchId, TEST_DOCTOR_USER_ID, day]
        );
      }
    }

    // 6. Login patient
    const patientRes = await request(app)
      .post('/auth/patient/login')
      .send({ username: TEST_PATIENT_USERNAME, password: TEST_PATIENT_PASSWORD });
    expect(patientRes.status).toBe(200);
    patientToken = patientRes.body.data.token;
    expect(patientToken).toBeDefined();

    // 7. Login admin
    const adminRes = await request(app)
      .post('/auth/admin/login')
      .send({ username: TEST_ADMIN_USERNAME, password: TEST_ADMIN_PASSWORD });
    expect(adminRes.status).toBe(200);
    adminToken = adminRes.body.data.token;
    expect(adminToken).toBeDefined();

    // 8. Reset queue
    await request(app)
      .post('/api/queue/reset')
      .set('Authorization', `Bearer ${adminToken}`)
      .send({
        branch_id: branchId,
        doctor_id: TEST_DOCTOR_USER_ID,
      });
  });

  afterAll(async () => {
    if (bookingId) {
      await query('DELETE FROM bookings WHERE id = $1', [bookingId]);
    }
    await pool.end();
    await redis.quit();
  });

  // ===== TESTS =====
  describe('Booking Flow', () => {
    it('should create a new booking', async () => {
      const res = await request(app)
        .post('/api/patient/bookings')
        .set('Authorization', `Bearer ${patientToken}`)
        .send({
          doctor_id: TEST_DOCTOR_USER_ID,
          slot_date_time: '2026-07-24T09:00:00Z',
          notes: 'Integration test booking',
        });

      expect(res.status).toBe(201);
      expect(res.body.success).toBe(true);
      expect(res.body.data).toHaveProperty('id');
      expect(res.body.data).toHaveProperty('booking_code');
      expect(res.body.data.status).toBe('PENDING');

      bookingId = res.body.data.id;
      bookingCode = res.body.data.booking_code;
    });

    it('should list bookings for the patient', async () => {
      const res = await request(app)
        .get('/api/patient/bookings')
        .set('Authorization', `Bearer ${patientToken}`)
        .query({ status: 'PENDING' });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.bookings).toBeInstanceOf(Array);
      expect(res.body.data.bookings.length).toBeGreaterThan(0);
    });

    it('should get booking detail', async () => {
      const res = await request(app)
        .get(`/api/patient/bookings/${bookingId}`)
        .set('Authorization', `Bearer ${patientToken}`);

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.id).toBe(bookingId);
      expect(res.body.data.booking_code).toBe(bookingCode);
    });

    it('should cancel booking', async () => {
      const res = await request(app)
        .put(`/api/patient/bookings/${bookingId}/cancel`)
        .set('Authorization', `Bearer ${patientToken}`);

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.status).toBe('CANCELLED');
      expect(res.body.data.cancelled_at).toBeDefined();
    });

    it('should not allow cancel again (already cancelled)', async () => {
      const res = await request(app)
        .put(`/api/patient/bookings/${bookingId}/cancel`)
        .set('Authorization', `Bearer ${patientToken}`);

      expect(res.status).toBe(409);
      expect(res.body.error).toBe('BOOKING_CANNOT_CANCEL');
    });
  });

  describe('Queue Management', () => {
    it('should get queue status (initial)', async () => {
      const res = await request(app)
        .get('/api/queue/status')
        .set('Authorization', `Bearer ${patientToken}`)
        .query({
          branch_id: branchId,
          doctor_id: TEST_DOCTOR_USER_ID,
        });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.current_queue_number).toBe(0);
      expect(res.body.data.total_waiting).toBe(0);
    });

    it('should generate queue numbers via Redis INCR (simulate check-ins)', async () => {
      const key = `queue:${branchId}:${TEST_DOCTOR_USER_ID}:20260722`;
      for (let i = 1; i <= 3; i++) {
        const num = await redis.incr(key);
        expect(num).toBe(i);
      }
    });

    it('should get updated queue status after check-ins', async () => {
      const res = await request(app)
        .get('/api/queue/status')
        .set('Authorization', `Bearer ${patientToken}`)
        .query({
          branch_id: branchId,
          doctor_id: TEST_DOCTOR_USER_ID,
        });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.current_queue_number).toBe(3);
      expect(res.body.data.total_waiting).toBe(3);
    });

    it('should reset queue (admin only)', async () => {
      const res = await request(app)
        .post('/api/queue/reset')
        .set('Authorization', `Bearer ${adminToken}`)
        .send({
          branch_id: branchId,
          doctor_id: TEST_DOCTOR_USER_ID,
        });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
    });

    it('should get queue status after reset', async () => {
      const res = await request(app)
        .get('/api/queue/status')
        .set('Authorization', `Bearer ${patientToken}`)
        .query({
          branch_id: branchId,
          doctor_id: TEST_DOCTOR_USER_ID,
        });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.data.current_queue_number).toBe(0);
      expect(res.body.data.total_waiting).toBe(0);
    });

    it('should reject non-admin from reset', async () => {
      const res = await request(app)
        .post('/api/queue/reset')
        .set('Authorization', `Bearer ${patientToken}`)
        .send({
          branch_id: branchId,
          doctor_id: TEST_DOCTOR_USER_ID,
        });

      expect(res.status).toBe(403);
      expect(res.body.message).toMatch(/forbidden/i);
    });
  });
});
