  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"TestPassword123!\",\n  \"fullName\": \"Test Patient\",\n  \"phone\": \"08123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/patient/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "patient",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has userId and token', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.success).to.be.true;",
                  "  pm.expect(jsonData.data.userId).to.be.a('string');",
                  "  pm.expect(jsonData.data.token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Patient",
          "request": {
            "method": "POST",
            "header": [
              {
