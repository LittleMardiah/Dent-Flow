              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "queue",
                "status"
              ],
              "query": [
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                },
                {
                  "key": "doctorId",
                  "value": "{{doctorId}}"
                }
              ]
            }
          },
          "response": [],
